<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="550.0" prefWidth="870.0" style="-fx-border-radius: 14; -fx-background-color: #fae1f9;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
  <top>
    <VBox spacing="8" style="-fx-background-color: #fae1f9;">
      <children>
        <Label styleClass="h1" text="Foods" />
      </children>
      <padding><Insets bottom="0" left="10" right="10" top="10" /></padding>
    </VBox>
  </top>
   <left>
    <VBox spacing="10" BorderPane.alignment="CENTER">
      <children>
        <TableView fx:id="table" minHeight="-Infinity" minWidth="-Infinity" prefHeight="420" prefWidth="700.0" style="-fx-background-color: #fae1f9;">
          <columns>
            <TableColumn fx:id="colName" prefWidth="260" text="Name" />
            <TableColumn fx:id="colCal" prefWidth="110" text="Calories" />
            <TableColumn fx:id="colP" prefWidth="110" text="Protein" />
            <TableColumn fx:id="colC" prefWidth="110" text="Carbs" />
            <TableColumn fx:id="colF" prefWidth="110" text="Fat" />
          </columns>
        </TableView>

        <Label fx:id="selLabel" />
      </children>
      <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
    </VBox>
   </left>
   <right>
      <VBox prefHeight="500.0" prefWidth="320.0" style="-fx-background-color: #fae1f9;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Name:" />
            <TextField fx:id="nameField" promptText="e.g. Apple" />
            <Label text="Calories per 100g(kcal):" />
            <TextField fx:id="calField" promptText="52" />
            <Label text="Protein:" />
            <TextField fx:id="pField" prefWidth="150.0" promptText="0.3" />
            <Label text="Carbs:" />
            <TextField fx:id="cField" prefWidth="166.0" promptText="14.0" />
            <Label text="Fats:" />
            <TextField fx:id="fField" promptText="0.2" />
            <Pane prefHeight="66.0" prefWidth="302.0">
               <children>
                  <Button layoutY="13.0" onAction="#handleAdd" prefHeight="35.0" prefWidth="80.0" styleClass="btn-3d" text="Add" />
                  <Button layoutX="95.0" layoutY="12.0" onAction="#handleSearch" prefHeight="35.0" prefWidth="80.0" styleClass="btn-3d" text="Search" />
                  <Button layoutX="196.0" layoutY="12.0" onAction="#handleDelete" prefHeight="35.0" prefWidth="80.0" styleClass="btn-3d" text="Delete" />
               </children>
            </Pane>
         </children>
      </VBox>
   </right>
   <center>
      <Separator orientation="VERTICAL" prefHeight="200.0" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
