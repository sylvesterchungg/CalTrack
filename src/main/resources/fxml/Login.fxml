<AnchorPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">
   <children>
      <ImageView fitHeight="462.0" fitWidth="531.0">
         <image>
            <Image url="@../styles/loginbg.png" />
         </image>
      </ImageView>
      <BorderPane prefHeight="462.0" prefWidth="531.0">
         <center>
            <VBox alignment="CENTER" fillWidth="true" prefHeight="252.0" prefWidth="531.0" spacing="16">
               <padding>
                  <Insets bottom="32" left="24" right="24" top="32" />
               </padding>
               <effect>
                  <Blend />
               </effect>
               <children>
                  <Label alignment="CENTER" prefHeight="27.0" prefWidth="531.0" text="Sign In to Your Account">
                     <font>
                        <Font size="15.0" />
                     </font>
                  </Label>
                  <GridPane hgap="12" maxWidth="420" vgap="12">
                     <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="110" />
                        <ColumnConstraints hgrow="ALWAYS" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                     <children>
                        <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="usernameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label fx:id="errorLabel" managed="false" textFill="red" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                     </children>
                  </GridPane>
                  <HBox alignment="CENTER" spacing="12">
                     <children>
                        <Button fx:id="loginBtn" defaultButton="true" onAction="#handleStart" styleClass="btn-3d" text="Log In" />
                        <Button fx:id="signupBtn" onAction="#handleSignup" text="Sign Up" />
                     </children>
                  </HBox>
                  <Label alignment="CENTER" prefHeight="18.0" prefWidth="489.0" text="©CalTrack powered by Optimum Nutrition">
                     <font>
                        <Font name="Symbol" size="13.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </center>
         <top>
            <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
               <children>
                  <GridPane prefHeight="143.0" prefWidth="574.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="189.60003662109375" minWidth="10.0" prefWidth="173.6" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="266.400048828125" minWidth="10.0" prefWidth="203.19999999999996" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="160.8000366210938" minWidth="10.0" prefWidth="155.20000000000005" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints maxHeight="58.60001220703125" minHeight="10.0" prefHeight="23.4" vgrow="SOMETIMES" />
                        <RowConstraints maxHeight="112.19998874664307" minHeight="10.0" prefHeight="103.4" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                        <ImageView fitHeight="104.0" fitWidth="174.0" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <image>
                              <Image url="@../icons/onlogo.png" />
                           </image>
                           <cursor>
                              <Cursor fx:constant="DEFAULT" />
                           </cursor>
                           <effect>
                              <Bloom />
                           </effect>
                        </ImageView>
                     </children>
                  </GridPane>
                  <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="39.0" prefWidth="537.0" text="Welcome Back to CalTrack">
                     <font>
                        <Font name="Agency FB Bold" size="32.0" />
                     </font>
                  </Label>
               </children>
               <effect>
                  <Blend />
               </effect>
            </VBox>
         </top>
         <effect>
            <Glow level="0.1" />
         </effect>
      </BorderPane>
   </children>
</AnchorPane>
